theme_minimal(base_size = 12)
#| label: complaints-scatterplot
#| fig-cap: "Relationship between handling of employee complaints and overall workplace rating"
ggplot(dat, aes(x = complaints, y = rating)) +
geom_point(alpha = 0.75) +
geom_smooth(
method = "lm",
se = TRUE,
color = "#27638A"
) +
labs(
x = "Complaints",
y = "Rating"
) +
theme_minimal(base_size = 12)
#| label: learning-scatterplot
#| fig-cap: "Relationship between opportunity to learn and overall workplace rating"
ggplot(dat, aes(x = learning, y = rating)) +
geom_point(alpha = 0.75) +
geom_smooth(
method = "lm",
se = TRUE,
color = "#27638A"
) +
labs(
x = "Learning",
y = "Rating"
) +
theme_minimal(base_size = 12)
#| label: raises-scatterplot
#| fig-cap: "Relationship between pay increases and overall workplace rating"
ggplot(dat, aes(x = raises, y = rating)) +
geom_point(alpha = 0.75) +
geom_smooth(
method = "lm",
se = TRUE,
color = "#27638A"
) +
labs(
x = "Raises",
y = "Rating"
) +
theme_minimal(base_size = 12)
#| label: fit-models
# Intercept-only model
mod0 <- lm(rating ~ 1, data = dat)
# Complaints model
mod1 <- lm(rating ~ complaints, data = dat)
# Complaints + learning model
mod2 <- lm(rating ~ complaints + learning, data = dat)
# Expanded model
mod3 <- lm(rating ~ complaints + learning + raises, data = dat)
```r
summary(mod0)
summary(mod1)
summary(mod2)
summary(mod3)
confint(mod3)
#| label: nested-tests
tests <- anova(mod0, mod1, mod2, mod3)
tests
#| label: prepare-nested-tests
tests <- tests |>
select(Res.Df, Df, F, `Pr(>F)`) |>
rename(
Residual.df = Res.Df,
Nested.Df = Df,
Nested.F.stat = F,
Nested.p.value = `Pr(>F)`
)
#| label: extract-model-metrics
glance0 <- glance(mod0)
glance1 <- glance(mod1)
glance2 <- glance(mod2)
glance3 <- glance(mod3)
#| label: combine-model-metrics
mods <- c(
"M0: Null",
"M1: Complaints",
"M2: + Learning",
"M3: + Raises"
)
glances <- rbind(
glance0,
glance1,
glance2,
glance3
)
#| label: combine-comparisons
comparison_table <- cbind(
Model = mods,
glances,
tests
)
#| label: prepare-comparison-table
comparison_table <- comparison_table |>
mutate(
Delta.R2 = r.squared - lag(r.squared),
RMSE = c(
sqrt(mean(residuals(mod0)^2)),
sqrt(mean(residuals(mod1)^2)),
sqrt(mean(residuals(mod2)^2)),
sqrt(mean(residuals(mod3)^2))
)
) |>
select(
Model,
r.squared,
Delta.R2,
adj.r.squared,
RMSE,
Residual.df,
Nested.Df,
Nested.F.stat,
Nested.p.value
)
#| label: model-comparison-table
#| tbl-cap: "Overall model performance and incremental nested-model comparisons"
comparison_table |>
gt() |>
cols_label(
Model = "Model",
r.squared = "R²",
Delta.R2 = "ΔR²",
adj.r.squared = "Adjusted R²",
RMSE = "RMSE",
Residual.df = "Residual df",
Nested.Df = "Nested df",
Nested.F.stat = "Nested F",
Nested.p.value = "Nested p"
) |>
fmt_number(
columns = c(
r.squared,
Delta.R2,
adj.r.squared,
RMSE,
Nested.F.stat
),
decimals = 3
) |>
fmt(
columns = Nested.p.value,
fns = function(x) {
ifelse(
is.na(x),
"—",
ifelse(x < .001, "< .001", sprintf("%.3f", x))
)
}
) |>
sub_missing(
columns = c(Delta.R2, Nested.Df, Nested.F.stat),
missing_text = "—"
)
#| label: performance-comparison
#| results: hide
performance_comparison <- compare_performance(
mod0,
mod1,
mod2,
mod3,
rank = TRUE
)
performance_comparison
plot(performance_comparison)
#| label: select-model
selected_row <- comparison_table |>
slice_max(
order_by = adj.r.squared,
n = 1,
with_ties = FALSE
)
selected_name <- selected_row$Model
selected_model <- switch(
selected_name,
"M0: Null" = mod0,
"M1: Complaints" = mod1,
"M2: + Learning" = mod2,
"M3: + Raises" = mod3
)
#| label: diagnostics
#| fig-cap: "Regression diagnostic plots for the provisionally selected model"
#| fig-width: 9
#| fig-height: 8
op <- par(mfrow = c(2, 2))
plot(selected_model)
par(op)
#| label: extract-coefficients
coefficient_results <- tidy(
selected_model,
conf.int = TRUE,
conf.level = 0.95
)
#| label: coefficient-table
#| tbl-cap: "Unstandardized regression coefficients for the selected model"
coefficient_results |>
select(
term,
estimate,
std.error,
conf.low,
conf.high,
p.value
) |>
gt() |>
cols_label(
term = "Predictor",
estimate = "Estimate",
std.error = "SE",
conf.low = "95% CI lower",
conf.high = "95% CI upper",
p.value = "p"
) |>
fmt_number(
columns = c(
estimate,
std.error,
conf.low,
conf.high
),
decimals = 3
) |>
fmt(
columns = p.value,
fns = function(x) {
ifelse(
x < .001,
"< .001",
sprintf("%.3f", x)
)
}
)
#| label: selected-model-performance
#| tbl-cap: "Overall performance of the selected model"
selected_row |>
select(
Model,
r.squared,
adj.r.squared,
RMSE
) |>
gt() |>
cols_label(
Model = "Model",
r.squared = "R²",
adj.r.squared = "Adjusted R²",
RMSE = "RMSE"
) |>
fmt_number(
columns = where(is.numeric),
decimals = 3
)
#| label: outcome-distribution
